    <bpmn:scriptTask id="ServiceTask_2" name="Inputs">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=foo" target="fooInput" />
          <zeebe:input source="=false" target="booleanFalseInput" />
          <zeebe:input source="=true" target="booleanTrueInput" />
          <zeebe:input source="={ foo: 1 }" target="contextInput" />
          <zeebe:input source="=foo + bar + baz" target="complexInput" />
          <zeebe:output source="=fooOutput" target="foo" />
          <zeebe:output source="=true" target="baz" />
        </zeebe:ioMapping>
        <zeebe:script expression="=fooInput + 2" resultVariable="fooOutput" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0szzvbm</bpmn:incoming>
      <bpmn:outgoing>Flow_1cskg4b</bpmn:outgoing>
