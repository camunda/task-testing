    <bpmn:scriptTask id="ServiceTask_1" name="No inputs">
      <bpmn:extensionElements>
        <zeebe:script expression="=foo + 1" resultVariable="fooPlusOne" />
        <zeebe:ioMapping>
          <zeebe:output source="=1" target="output1" />
          <zeebe:output source="=true" target="output2" />
          <zeebe:output source="={ &#34;foo&#34;: 1 }" target="output3" />
          <zeebe:output source="=&#34;foo&#34;" target="output4" />
          <zeebe:output source="=fooPlusOne" target="fooPlusOneOutput" />
