{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "strict": true,
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./lib/types.d.ts"]
  },
  "include": ["lib/**/*", "lib/types.d.ts"],
  "exclude": ["node_modules"]
}
